#!/usr/bin/env python3
"""Entry point for the `openrtx` command; works through a symlink on the PATH."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from openrtx.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
